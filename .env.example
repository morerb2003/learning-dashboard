# Supabase Configuration
# Replace these with your actual Supabase project keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Upstash Redis Configuration (Server-only - Never prefix with NEXT_PUBLIC_)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Optional Playwright E2E accounts
E2E_STUDENT_EMAIL=student@example.com
E2E_STUDENT_PASSWORD=replace-with-test-password
E2E_TEACHER_EMAIL=teacher@example.com
E2E_TEACHER_PASSWORD=replace-with-test-password
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=replace-with-test-password

# Optional: test a deployed environment instead of starting Next.js locally
# E2E_BASE_URL=https://your-deployment.example.com

# Razorpay Payment Gateway Configuration (Test Mode: rzp_test_...)
# RAZORPAY_KEY_ID is the public test/live key
# RAZORPAY_KEY_SECRET & RAZORPAY_WEBHOOK_SECRET are STRICTLY SERVER-ONLY!
# NEVER prefix RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET with NEXT_PUBLIC_!
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx
PAYMENT_GATEWAY=razorpay
